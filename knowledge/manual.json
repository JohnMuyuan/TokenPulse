    },
    {
      "match": "gpt-5\\.4-mini",
      "input": 0.75,
      "output": 4.5,
      "cacheRead": 0.075,
      "cacheWrite": 0,
      "note": "GPT-5.4 mini"
    },
    {
      "match": "gpt-5\\.4",
      "input": 2.5,
      "output": 15,
      "cacheRead": 0.25,
      "cacheWrite": 0,
      "note": "GPT-5.4"
    },
    {
      "match": "gpt-5\\.2",
      "input": 1.75,
      "output": 14,
      "cacheRead": 0.175,
      "cacheWrite": 0,
      "note": "GPT-5.2"
    },
    {
      "match": "gpt-(5\\.[56]|6)",
      "input": 5,
