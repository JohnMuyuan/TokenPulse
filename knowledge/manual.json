      "cacheWrite": 3.75,
      "note": "Claude（按 Sonnet 估）"
    },
    {
      "match": "gpt-5\\.4-nano",
      "input": 0.2,
      "output": 1.25,
      "cacheRead": 0.02,
      "cacheWrite": 0,
