  ],
  "aliases": [
    {
      "match": "\\[[^\\]]*\\]$",
      "replace": "",
      "note": "Claude Code 的 [1m] 上下文标记，响应里没有"
    },
    {
      "match": "^(?:[a-z]{2}\\.)?(?:anthropic|openai|xai)[./]",
      "replace": "",
      "note": "云厂商前缀（Bedrock 的 us.anthropic.）"
    },
    {
      "match": "@\\d{8}$",
      "replace": "",
      "note": "Vertex 的 @日期 后缀"
    },
    {
      "match": "-v\\d+(?::\\d+)?$",
      "replace": "",
      "note": "Bedrock 的 -v1:0 后缀"
    },
    {
      "match": "-(?:20\\d{6}|20\\d{2}-\\d{2}-\\d{2})$",
      "replace": "",
      "note": "日期快照后缀"
    },
    {
      "match": "^(grok-[\\d.]+)-build$",
      "replace": "$1",
      "note": "Grok Build 用的是同一型号的 -build 变体"
    }
  ],
  "capabilities": {
    "checkedAt": "2026-09-28",
    "claude": {
      "source": "https://platform.claude.com/docs/en/build-with-claude/effort",
      "modelsSource": "https://platform.claude.com/docs/en/about-claude/models/overview",
      "models": [
        "claude-fable-5-1",
        "claude-opus-5-5",
        "claude-sonnet-5",
        "claude-haiku-4-5-20251001"
      ],
      "rules": [
        {
          "match": "^claude-(?:fable-(?:5-1|5)|mythos-(?:5-1|5)|opus-(?:5-5|5|4-8|4-7)|sonnet-5)(?:$|\\[|-\\d{8}$)",
          "efforts": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        {
          "match": "^claude-(?:mythos-preview|opus-4-6|sonnet-4-6)(?:$|\\[|-\\d{8}$)",
          "efforts": [
            "low",
            "medium",
            "high",
            "max"
          ]
        },
        {
          "match": "^claude-opus-4-5(?:$|\\[|-\\d{8}$)",
          "efforts": [
            "low",
            "medium",
            "high"
          ]
        },
        {
          "match": "^claude-haiku-4-5(?:$|\\[|-\\d{8}$)",
          "efforts": [
            "not_supported"
          ]
        }
      ]
    },
    "grok": {
      "source": "https://docs.x.ai/docs/guides/reasoning",
      "models": [
        "grok-4.7",
        "grok-4.6",
        "grok-4.5",
        "grok-4.20-multi-agent"
      ],
      "rules": [
        {
          "match": "^grok-4\\.(?:7|6)$",
          "efforts": [
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        {
          "match": "^grok-4\\.5$",
          "efforts": [
            "low",
            "medium",
            "high"
          ]
        },
        {
          "match": "^grok-4\\.20-multi-agent$",
          "efforts": [
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "semantics": "agent_count"
        }
      ]
    }
  },
  "labels": [
    {
      "model": "gpt-5.6-sol",
      "promo": true,
      "note": "OpenAI 官方目前是优惠价（输入 $4 / 输出 $20，缓存读 $0.40，缓存写 $5；长上下文 >272K 输入翻倍），结束时间未公布。"
    }
  ]
}
