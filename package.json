{
  "name": "tokenpulse",
  "version": "0.3.1",
  "private": true,
  "description": "TokenPulse — Your AI usage, at a glance.",
  "author": "TokenPulse",
  "main": "build/main/index.js",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "start": "npm run compile && electron .",
    "dev": "npm run compile && electron . --dev",
    "icons": "node scripts/make-icon.cjs",
    "test": "npm run compile && node scripts/test-quota-monitor.cjs && node scripts/test-usage-scan.cjs && node scripts/test-dashboard.cjs && node scripts/test-accounts.cjs",
    "test:ui": "npm run compile && electron scripts/test-ui.cjs",
    "dist:portable": "npm run icons && npm run compile && electron-builder --win portable --publish never",
    "dist": "npm run icons && npm run compile && electron-builder --publish never",
    "test:update": "npm run compile && electron scripts/test-updater.cjs"
  },
  "build": {
    "appId": "com.tokenpulse.app",
    "productName": "TokenPulse",
    "directories": {
      "output": "dist",
      "buildResources": "packaging"
    },
    "files": [
      "build/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "packaging",
        "to": "packaging",
        "filter": [
          "*.png"
        ]
      }
    ],
    "win": {
      "icon": "packaging/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TokenPulse-${version}-Setup.${ext}",
      "shortcutName": "TokenPulse"
    },
    "portable": {
      "artifactName": "TokenPulse-${version}-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JohnMuyuan",
        "repo": "TokenPulse",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
